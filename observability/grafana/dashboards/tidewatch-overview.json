{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Temperature readings accepted",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(tidewatch_temperature_readings_total)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2,
      "title": "Current sea temperature",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0},
      "targets": [{"expr": "tidewatch_current_temperature_celsius", "legendFormat": "{{buoy_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 2}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 3,
      "title": "Silent buoys",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4},
      "targets": [{"expr": "count(time() - tidewatch_buoy_last_seen_timestamp_seconds > 1800)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 4,
      "title": "Time since last buoy reading",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [{"expr": "time() - tidewatch_buoy_last_seen_timestamp_seconds", "legendFormat": "{{buoy_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0}, "overrides": []}
    },
    {
      "id": 5,
      "title": "Current pressure",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "tidewatch_current_pressure_kpa", "legendFormat": "{{buoy_id}} / {{sensor_channel}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "pressurekpa", "decimals": 3}, "overrides": []}
    },
    {
      "id": 6,
      "title": "Current salinity",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "tidewatch_current_salinity_psu", "legendFormat": "{{buoy_id}} / {{sensor_channel}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3}, "overrides": []}
    },
    {
      "id": 7,
      "title": "Degraded sensors",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
      "targets": [{"expr": "sum(tidewatch_sensor_degraded)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 8,
      "title": "Reading quality",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 24},
      "targets": [{"expr": "sum by (quality) (rate(tidewatch_reading_quality_total[5m]))", "legendFormat": "{{quality}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 9,
      "title": "Battery level",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [{"expr": "tidewatch_battery_percent", "legendFormat": "{{buoy_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 10,
      "title": "Experimental buoy movement speed",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [{"expr": "tidewatch_buoy_movement_speed_mps", "legendFormat": "{{buoy_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "mps", "decimals": 3, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 11,
      "title": "Redundant battery levels",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "targets": [{"expr": "tidewatch_battery_device_percent", "legendFormat": "{{buoy_id}} / {{device_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 12,
      "title": "Battery A/B delta",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "targets": [{"expr": "tidewatch_battery_delta_percent", "legendFormat": "{{buoy_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}]}}, "overrides": []}
    },
    {
      "id": 13,
      "title": "Missing redundant devices",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 48},
      "targets": [{"expr": "sum(tidewatch_redundant_device_missing)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 14,
      "title": "Missing sensor channels",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 48},
      "targets": [{"expr": "sum(tidewatch_sensor_channel_missing)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 15,
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 52},
      "targets": [{"expr": "sum by (method, status_code) (rate(tidewatch_http_requests_total[5m]))", "legendFormat": "{{method}} {{status_code}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 16,
      "title": "HTTP request latency p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 52},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, method) (rate(tidewatch_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{method}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 17,
      "title": "Sensor health decisions",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 60},
      "targets": [{"expr": "sum by (decision) (tidewatch_sensor_health_decision)", "legendFormat": "{{decision}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 18,
      "title": "IMU motion vectors",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 68},
      "targets": [
        {"expr": "tidewatch_current_imu_acceleration_mps2", "legendFormat": "acc {{buoy_id}} / {{sensor_channel}} / {{axis}}", "refId": "A"},
        {"expr": "tidewatch_current_imu_angular_velocity_dps", "legendFormat": "gyro {{buoy_id}} / {{sensor_channel}} / {{axis}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 19,
      "title": "Ambient light",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 76},
      "targets": [{"expr": "tidewatch_current_ambient_light_lux", "legendFormat": "{{buoy_id}} / {{sensor_channel}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "lux", "decimals": 2}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 20,
      "title": "Wind speed and direction",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 84},
      "targets": [
        {"expr": "tidewatch_current_wind_speed_mps", "legendFormat": "speed {{buoy_id}} / {{sensor_channel}}", "refId": "A"},
        {"expr": "tidewatch_current_wind_direction_degrees", "legendFormat": "direction {{buoy_id}} / {{sensor_channel}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 2}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 21,
      "title": "Marine current speed and direction",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 92},
      "targets": [
        {"expr": "tidewatch_current_marine_current_speed_mps", "legendFormat": "speed {{buoy_id}} / {{sensor_channel}}", "refId": "A"},
        {"expr": "tidewatch_current_marine_current_direction_degrees", "legendFormat": "direction {{buoy_id}} / {{sensor_channel}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 22,
      "title": "Turbidity",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 100},
      "targets": [{"expr": "tidewatch_current_turbidity_ntu", "legendFormat": "{{buoy_id}} / {{sensor_channel}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 23,
      "title": "Dissolved oxygen",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 108},
      "targets": [{"expr": "tidewatch_current_dissolved_oxygen_mg_l", "legendFormat": "{{buoy_id}} / {{sensor_channel}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 24,
      "title": "pH",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 116},
      "targets": [{"expr": "tidewatch_current_ph", "legendFormat": "{{buoy_id}} / {{sensor_channel}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 25,
      "title": "Conductivity",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 124},
      "targets": [{"expr": "tidewatch_current_conductivity_us_cm", "legendFormat": "{{buoy_id}} / {{sensor_channel}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 2}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    }
  ],
  "schemaVersion": 39,
  "tags": ["tidewatch", "azure", "buoys"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Tidewatch overview",
  "uid": "tidewatch-overview",
  "version": 2
}
